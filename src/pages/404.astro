---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noindex>
  <section class="seccion">
    <div class="contenedor" style="max-width:860px">
      <h1>Te has salido del camino.</h1>
      <p class="texto">La página que buscas no existe o se ha movido. Vuelve al inicio o mira qué noches hay libres.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/">Ir al inicio</a><a class="btn btn--linea" href="/reservar/">Ver noches libres</a></div>
    </div>
  </section>
</Base>
